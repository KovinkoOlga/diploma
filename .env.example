ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_INITIAL_SECONDS=60
EMAIL_CODE_RESEND_MAX_SECONDS=900
EMAIL_CODE_MAX_ATTEMPTS=5
AUTH_DEV_RETURN_EMAIL_CODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
S3_ENDPOINT_URL=https://s3.storage.selcloud.ru
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_PRIVATE=wardrobe-private
S3_REGION=ru-1
S3_PRESIGNED_EXPIRE_SECONDS=3600
S3_FORCE_PATH_STYLE=true
ML_VISION_SERVICE_URL=http://ml-vision-service:8001
BACKEND_INTERNAL_URL=http://backend:8000
INTERNAL_SERVICE_TOKEN=change-me-in-local-dev
WARDROBE_IMAGE_CANVAS_SIZE=512
WARDROBE_IMAGE_PADDING_RATIO=0.22
WARDROBE_IMAGE_MIN_PADDING_PX=48
WARDROBE_IMAGE_ALPHA_THRESHOLD=8
CLASSIFIER_MODEL_PATH=/app/models/wardrobe_classifier.keras
CLASSIFIER_ARTIFACTS_DIR=/app/models/classifier_artifacts
CLASSIFIER_ENABLE_STUB=false
CLASSIFIER_IMG_SIZE=320
CLASSIFIER_TOP_K=3
CLASSIFIER_USE_CUTOUT=true
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SQLADMIN_USERNAME=admin
SQLADMIN_PASSWORD=change-me
DEFAULT_USER_EMAIL=demo@example.com
